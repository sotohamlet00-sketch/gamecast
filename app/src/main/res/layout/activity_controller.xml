<?xml version="1.0" encoding="utf-8"?>
<!-- Mando: izquierda (L2/L1, stick, D-pad) | centro (estado y acciones) | derecha (R1/R2, ABXY, stick).
     El padding lo pone ControllerActivity según los insets del sistema. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:baselineAligned="false" android:clipChildren="false" android:clipToPadding="false"
    android:orientation="horizontal">

    <!-- ============ IZQUIERDA ============ -->
    <LinearLayout
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:clipChildren="false" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
            android:clipChildren="false" android:orientation="horizontal">
            <TextView android:id="@+id/btnL2" style="@style/PadRect" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="L2" />
            <TextView android:id="@+id/btnL1" style="@style/PadRect" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="L1" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:padding="4dp">
            <com.example.gamepadhid.ui.JoystickView
                android:id="@+id/joyLeft"
                android:layout_width="match_parent" android:layout_height="match_parent" />
        </FrameLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:clipChildren="false">
        <GridLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:clipChildren="false"
            android:rowCount="3" android:columnCount="3">
            <TextView android:id="@+id/dpUp" style="@style/PadRect" android:layout_width="42dp" android:layout_height="42dp" android:layout_margin="3dp" android:layout_row="0" android:layout_column="1" android:text="▲" />
            <TextView android:id="@+id/dpLeft" style="@style/PadRect" android:layout_width="42dp" android:layout_height="42dp" android:layout_margin="3dp" android:layout_row="1" android:layout_column="0" android:text="◀" />
            <TextView android:id="@+id/dpRight" style="@style/PadRect" android:layout_width="42dp" android:layout_height="42dp" android:layout_margin="3dp" android:layout_row="1" android:layout_column="2" android:text="▶" />
            <TextView android:id="@+id/dpDown" style="@style/PadRect" android:layout_width="42dp" android:layout_height="42dp" android:layout_margin="3dp" android:layout_row="2" android:layout_column="1" android:text="▼" />
        </GridLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- ============ CENTRO ============ -->
    <LinearLayout
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_marginHorizontal="8dp" android:layout_weight="0.95"
        android:clipChildren="false" android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <View
                android:id="@+id/dotCtl"
                android:layout_width="8dp" android:layout_height="8dp"
                android:background="@drawable/bg_dot" />
            <TextView
                android:id="@+id/tvHid"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Pad.Status" />
        </LinearLayout>
        <TextView
            android:id="@+id/tvTv"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Pad.Caption" />

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <TextView android:id="@+id/btnPair" style="@style/PadSmall"
            android:layout_width="match_parent" android:layout_height="38dp"
            android:layout_margin="4dp" android:text="@string/btn_pair" />
        <TextView android:id="@+id/btnDisconnect" style="@style/PadSmall"
            android:layout_width="match_parent" android:layout_height="38dp"
            android:layout_margin="4dp" android:text="@string/btn_disconnect" />
        <TextView android:id="@+id/btnHome" style="@style/PadSmall"
            android:layout_width="match_parent" android:layout_height="38dp"
            android:layout_margin="4dp" android:text="@string/btn_home" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp"
            android:layout_marginTop="6dp" android:clipChildren="false" android:orientation="horizontal">
            <TextView android:id="@+id/btnSelect" style="@style/PadSmall" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="SEL" />
            <TextView android:id="@+id/btnMode" style="@style/PadSmall" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="◉" />
            <TextView android:id="@+id/btnStart" style="@style/PadSmall" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="START" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp"
            android:clipChildren="false" android:orientation="horizontal">
            <TextView android:id="@+id/btnL3" style="@style/PadSmall" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="L3" />
            <TextView android:id="@+id/btnR3" style="@style/PadSmall" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="R3" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ DERECHA ============ -->
    <LinearLayout
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:clipChildren="false" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
            android:clipChildren="false" android:orientation="horizontal">
            <TextView android:id="@+id/btnR1" style="@style/PadRect" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="R1" />
            <TextView android:id="@+id/btnR2" style="@style/PadRect" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="R2" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:clipChildren="false">
        <GridLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:clipChildren="false"
            android:rowCount="3" android:columnCount="3">
            <TextView android:id="@+id/btnY" style="@style/PadRound" android:layout_width="42dp" android:layout_height="42dp" android:layout_margin="3dp" android:layout_row="0" android:layout_column="1" android:text="Y" />
            <TextView android:id="@+id/btnX" style="@style/PadRound" android:layout_width="42dp" android:layout_height="42dp" android:layout_margin="3dp" android:layout_row="1" android:layout_column="0" android:text="X" />
            <TextView android:id="@+id/btnB" style="@style/PadRound" android:layout_width="42dp" android:layout_height="42dp" android:layout_margin="3dp" android:layout_row="1" android:layout_column="2" android:text="B" />
            <TextView android:id="@+id/btnA" style="@style/PadRound" android:layout_width="42dp" android:layout_height="42dp" android:layout_margin="3dp" android:layout_row="2" android:layout_column="1" android:text="A" />
        </GridLayout>
        </FrameLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:padding="4dp">
            <com.example.gamepadhid.ui.JoystickView
                android:id="@+id/joyRight"
                android:layout_width="match_parent" android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
