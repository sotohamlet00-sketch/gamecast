<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:clipToPadding="false" android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btnBack"
                android:layout_width="44dp" android:layout_height="44dp"
                android:contentDescription="@android:string/cancel"
                android:gravity="center" android:text="‹"
                android:textAppearance="@style/TextAppearance.GC.Display" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:text="@string/shizuku_title"
                android:textAppearance="@style/TextAppearance.GC.Display" android:textSize="24sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card" android:elevation="3dp"
            android:orientation="vertical" android:padding="20dp">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <View
                    android:id="@+id/dotShizuku"
                    android:layout_width="12dp" android:layout_height="12dp"
                    android:background="@drawable/bg_dot" />
                <TextView
                    android:id="@+id/tvShizukuStatus"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.GC.Title" />
            </LinearLayout>
            <TextView
                android:id="@+id/btnShizukuInstall"
                style="@style/GCButtonPrimary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/shizuku_btn_install" />
            <TextView
                android:id="@+id/btnShizukuOpen"
                style="@style/GCButtonSecondary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/shizuku_btn_open" />
            <TextView
                android:id="@+id/btnShizukuPermission"
                style="@style/GCButtonPrimary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/shizuku_btn_permission" />
            <TextView
                android:id="@+id/btnShizukuTest"
                style="@style/GCButtonSecondary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/shizuku_btn_test" />
            <TextView
                android:id="@+id/btnShizukuContinue"
                style="@style/GCButtonPrimary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/shizuku_btn_continue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card" android:elevation="3dp"
            android:orientation="vertical" android:padding="20dp">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/shizuku_what_title"
                android:textAppearance="@style/TextAppearance.GC.Title" />
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/shizuku_what_body"
                android:textAppearance="@style/TextAppearance.GC.Body" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card" android:elevation="3dp"
            android:orientation="vertical" android:padding="20dp">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/shizuku_use_title"
                android:textAppearance="@style/TextAppearance.GC.Title" />
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/shizuku_use_body"
                android:textAppearance="@style/TextAppearance.GC.Body" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card" android:elevation="3dp"
            android:orientation="vertical" android:padding="20dp">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/shizuku_steps_title"
                android:textAppearance="@style/TextAppearance.GC.Title" />
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/shizuku_steps_body"
                android:textAppearance="@style/TextAppearance.GC.Body" />
            <TextView
                android:id="@+id/btnShizukuGuide"
                style="@style/GCButtonSecondary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/shizuku_btn_guide" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card" android:elevation="3dp"
            android:orientation="vertical" android:padding="20dp">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/shizuku_diag_title"
                android:textAppearance="@style/TextAppearance.GC.Title" />
            <TextView
                android:id="@+id/tvDiag"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textIsSelectable="true"
                android:textAppearance="@style/TextAppearance.GC.Caption" />
            <TextView
                android:id="@+id/btnCopyDiag"
                style="@style/GCButtonSecondary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/shizuku_btn_copy" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
