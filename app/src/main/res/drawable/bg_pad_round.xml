<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="@color/pad_accent_light" android:endColor="@color/pad_accent_dark" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="@color/pad_key_top" android:endColor="@color/pad_key_bottom" />
            <stroke android:width="1dp" android:color="@color/pad_key_stroke" />
        </shape>
    </item>
</selector>
